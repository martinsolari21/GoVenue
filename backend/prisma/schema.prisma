generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organizador {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  eventos   Evento[]

  @@map("organizadores")
}

model Jugador {
  id            Int            @id @default(autoincrement())
  nombre        String
  email         String         @unique
  password      String
  telefono      String?
  ciudad        String?
  provincia     String?        @default("Buenos Aires")
  createdAt     DateTime       @default(now())
  inscripciones Inscripcion[]

  @@map("jugadores")
}

model Localidad {
  id     Int     @id @default(autoincrement())
  nombre String
  zona   String
  venues Venue[]

  @@map("localidades")
}

model Deporte {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  icono   String?
  eventos Evento[]

  @@map("deportes")
}

model Venue {
  id          Int       @id @default(autoincrement())
  nombre      String
  direccion   String
  localidadId Int
  localidad   Localidad @relation(fields: [localidadId], references: [id])
  createdAt   DateTime  @default(now())
  eventos     Evento[]

  @@map("venues")
}

model Evento {
  id            Int           @id @default(autoincrement())
  titulo        String
  descripcion   String?
  fecha         DateTime
  horaInicio    String
  horaFin       String
  cupos         Int
  precio        Decimal?
  vistas        Int           @default(0)
  estado        EstadoEvento  @default(BORRADOR)
  deporteId     Int
  deporte       Deporte       @relation(fields: [deporteId], references: [id])
  venueId       Int
  venue         Venue         @relation(fields: [venueId], references: [id])
  organizadorId Int
  organizador   Organizador   @relation(fields: [organizadorId], references: [id])
  inscripciones Inscripcion[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("eventos")
}

model Inscripcion {
  id        Int                @id @default(autoincrement())
  eventoId  Int
  evento    Evento             @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  jugadorId Int
  jugador   Jugador            @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  estado    EstadoInscripcion  @default(INSCRIPTO)
  createdAt DateTime           @default(now())

  @@unique([eventoId, jugadorId])
  @@map("inscripciones")
}

enum EstadoEvento {
  BORRADOR
  PUBLICADO
  CANCELADO
  FINALIZADO
}

enum EstadoInscripcion {
  INSCRIPTO
  CANCELADO
  LISTA_ESPERA
}
