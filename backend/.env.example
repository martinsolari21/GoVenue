# Base de datos PostgreSQL (Supabase)
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/govenue?schema=public"

# JWT Secret — cambiar por una clave larga y aleatoria
JWT_SECRET="CAMBIAR_ESTA_CLAVE_POR_UNA_SEGURA"

# URL del frontend (para CORS)
FRONTEND_URL="http://localhost:5173"

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3000

NODE_ENV=development
